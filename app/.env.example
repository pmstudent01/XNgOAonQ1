# Copy to .env and adjust as needed.

# Base URL of the Vehicle Service API.
# Default points at the local Postman mock (Local - Agent Mode environment).
VEHICLE_SERVICE_BASE_URL=http://localhost:4501

# API key sent as the X-API-Key header. Leave blank if the API is unauthenticated.
VEHICLE_SERVICE_API_KEY=

# Per-request timeout in seconds.
VEHICLE_SERVICE_TIMEOUT=30
